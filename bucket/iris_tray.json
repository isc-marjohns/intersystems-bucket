{
  "version": "1.0.4.0",
  "description": "InterSystems Windows Tray",
  "homepage": "https://www.intersystems.com/",
  "license": "Proprietary",
  "architecture": {
    "64bit": {
      "url": [
                "https://iris-windows-tray-bucket.s3.us-east-2.amazonaws.com/v1.0.4.0/IrisNotificationArea_1.0.4.0_x64.msix"
      ],
      "hash": [
                "sha256:891ac62e05bd553e9229c49089f6e819217667050ec4d1539d732c5ad76d6894"
            ]
    }
  },
  "innosetup": true,
  "shortcuts": [
    [
      "IrisNotificationArea.exe",
      "IRIS Windows Tray"
    ]
  ],
  "pre_install": [
    "Stop-Process -Name 'IrisNotificationArea' -Force -ErrorAction SilentlyContinue"
  ],
  "installer": {
    "script": [
      "Write-Host 'Registering MSIX Package with Windows...' -ForegroundColor Cyan",
      "Add-AppxPackage -Path (Get-ChildItem \"$dir\\*.msix\").FullName"
    ]
  },
  "pre_uninstall": [
    "Stop-Process -Name 'IrisNotificationArea' -Force -ErrorAction SilentlyContinue"
  ],
  "uninstaller": {
    "script": [
      "Write-Host 'Removing MSIX Package...' -ForegroundColor Cyan",
      "$app = Get-AppxPackage -Name '*IrisNotificationArea*'",
      "if ($app) { Remove-AppxPackage -Package $app.PackageFullName }"
    ]
  }
}